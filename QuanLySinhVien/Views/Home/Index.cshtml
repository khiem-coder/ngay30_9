@{
    ViewData["Title"] = "Trang chủ";
}
<div class="text-center mb-4">
    <h1>Hệ thống quản lý sinh viên</h1>
    <p class="text-muted">ASP.NET Core MVC - Entity Framework Core (Code First) - SQL Server</p>
</div>
<div class="row g-3 justify-content-center">
    <div class="col-md-4">
        <div class="card text-center p-4">
            <h2 class="text-primary">@ViewBag.TotalStudents</h2>
            <div>Sinh viên</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-4">
            <h2 class="text-success">@ViewBag.TotalClasses</h2>
            <div>Lớp học</div>
        </div>
    </div>
</div>
<div class="text-center mt-4">
    <a class="btn btn-primary btn-lg" asp-controller="Students" asp-action="Index">Quản lý sinh viên</a>
</div>
