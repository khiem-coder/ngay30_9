@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
}
<h2 class="mb-3">Thêm sinh viên</h2>
<div class="card p-4">
    @* enctype="multipart/form-data" BẮT BUỘC thì mới upload được file *@
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <partial name="_Form" model="Model" />

        @* ===== UPLOAD HÌNH ẢNH (1 hoặc nhiều ảnh) ===== *@
        <div class="mt-3">
            <label class="form-label">Hình ảnh (có thể chọn nhiều ảnh, chỉ .jpg / .png, tối đa 2 MB/ảnh)</label>
            <input type="file" id="imageInput" name="images" class="form-control" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
            <span class="text-danger d-block mt-1" id="imageError">@Html.ValidationMessage("images")</span>
            <div id="preview" class="d-flex flex-wrap gap-2 mt-2"></div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Lưu</button>
            <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Kiểm tra nhanh phía trình duyệt (server vẫn kiểm tra lại)
        (function () {
            const input = document.getElementById('imageInput');
            const error = document.getElementById('imageError');
            const preview = document.getElementById('preview');
            const allowed = ['image/jpeg', 'image/png'];

            input.addEventListener('change', function () {
                error.textContent = '';
                preview.innerHTML = '';
                for (const f of input.files) {
                    if (!allowed.includes(f.type)) {
                        error.textContent = 'File "' + f.name + '" không hợp lệ. Chỉ cho phép ảnh .jpg hoặc .png.';
                        input.value = '';
                        preview.innerHTML = '';
                        return;
                    }
                    const img = document.createElement('img');
                    img.src = URL.createObjectURL(f);
                    img.style.cssText = 'width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #ddd';
                    preview.appendChild(img);
                }
            });
        })();
    </script>
}