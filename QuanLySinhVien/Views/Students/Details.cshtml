@model Student
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}
<h2 class="mb-3">Chi tiết sinh viên</h2>
<div class="card p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.StudentCode)</dt><dd class="col-sm-9">@Model.StudentCode</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DateOfBirth)</dt><dd class="col-sm-9">@Model.DateOfBirth.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Gender)</dt><dd class="col-sm-9">@Model.Gender</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt><dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Address)</dt><dd class="col-sm-9">@Model.Address</dd>
        <dt class="col-sm-3">Lớp</dt><dd class="col-sm-9">@Model.ClassRoom?.ClassName (@Model.ClassRoom?.Major)</dd>
    </dl>
    <div class="mt-4">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
        <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>
